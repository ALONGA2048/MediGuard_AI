# Host ports; container ports stay at 3000 and 3001.
WEBSITE_PORT=3000
TESTER_PORT=3001

# Set the Raspberry Pi's actual LAN IP, e.g. http://192.168.1.50:5000.
# host.docker.internal points to the Docker host, NOT to a separate Pi.
RASPBERRY_PI_BASE_URL=http://host.docker.internal:5000
# Must match MEDILENS_DEVICE_TOKEN on the Raspberry Pi.
RASPBERRY_PI_DEVICE_TOKEN=
