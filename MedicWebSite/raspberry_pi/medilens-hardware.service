[Unit]
Description=MediLens Raspberry Pi hardware API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/admin/yolo_env
EnvironmentFile=/home/admin/yolo_env/.env
ExecStart=/home/admin/yolo_env/bin/python -u /home/admin/yolo_env/hardware.py
Restart=on-failure
RestartSec=3
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
