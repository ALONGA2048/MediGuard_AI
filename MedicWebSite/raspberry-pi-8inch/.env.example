# Literal values; do not add shell quotes. Environment variables override this file.
POS_HOST=127.0.0.1
POS_PORT=8088
POS_DEVICE_ID=mediguard-pi-01
# Optional: absolute SQLite file path. Default: data/pos.sqlite3
# POS_DB=/home/your-user/pos-data/pos.sqlite3
# Remote receiver running this same server.py, published with Tailscale Serve:
# POS_SYNC_URL=https://mediguard-receiver.your-tailnet.ts.net/api/receive
POS_SYNC_URL=
# Generate a long random token; use the identical value on sender and receiver.
POS_SYNC_TOKEN=
