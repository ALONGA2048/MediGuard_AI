# Literal NAME=value values, without quotes. Never commit the real .env.
POS_HOST=127.0.0.1
POS_PORT=8088
POS_HARDWARE_URL=http://127.0.0.1:5000
# Same device token is used by the proxy and original hardware service.
# Blank allows only loopback clients in the original hardware implementation.
MEDILENS_DEVICE_TOKEN=
MEDILENS_LISTEN_PORT=5000
# Set the real MedicServer URL, e.g. http://server-tailnet-ip:8000/api/v1/verifications
MEDILENS_BACKEND_UPLOAD_URL=
MEDILENS_BACKEND_UPLOAD_TOKEN=
# Original camera, focus and LED settings are retained.
MEDILENS_CAMERA_1=0
MEDILENS_CAMERA_2=2
MEDILENS_CAMERA_1_FOCUS=340
MEDILENS_CAMERA_2_FOCUS=0
MEDILENS_CAPTURE_WIDTH=1920
MEDILENS_CAPTURE_HEIGHT=1080
MEDILENS_CAPTURE_FPS=30
MEDILENS_RESERVED_LED_RGB=0,0,0
# Reduced preview only. Full HD originals still go to MedicServer.
MEDILENS_PREVIEW_WIDTH=640
MEDILENS_PREVIEW_HEIGHT=360
MEDILENS_PREVIEW_FPS=3
MEDILENS_PREVIEW_JPEG_QUALITY=75
# Optional overrides:
# MEDILENS_CAPTURE_DIR=/home/master/mediguard-captures
# MEDILENS_HARDWARE_SOURCE=/home/master/MediGuard_AI/MedicWebSite/raspberry_pi/hardware.py
# POS_REQUEST_DIR=/home/master/mediguard-requests
